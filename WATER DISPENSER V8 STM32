static void pulse(GPIO_TypeDef *port, uint16_t pin) { HAL_GPIO_WritePin(port,pin,GPIO_PIN_SET); HAL_GPIO_WritePin(port,pin,GPIO_PIN_RESET); }
static void shift_write(uint16_t v) {
  /* U16 recibe primero; U22 recibe el byte alto. Se envian 16 bits MSB primero. */
  HAL_GPIO_WritePin(GPIOB,SR_LATCH_Pin,GPIO_PIN_RESET);
  for (int i=15;i>=0;i--) { HAL_GPIO_WritePin(GPIOB,SR_DATA_Pin,(v&(1U<<i))?GPIO_PIN_SET:GPIO_PIN_RESET); pulse(GPIOB,SR_CLOCK_Pin); }
  HAL_GPIO_WritePin(GPIOB,SR_LATCH_Pin,GPIO_PIN_SET);
}
static void set_shift(uint8_t bit, bool on) { if(on) shift_register|=(1U<<bit); else shift_register&=~(1U<<bit); shift_write(shift_register); }
static void max_write(uint8_t reg,uint8_t data) { HAL_GPIO_WritePin(GPIOB,MAX_CS_Pin,GPIO_PIN_RESET); for(int i=15;i>=0;i--){ uint16_t w=((uint16_t)reg<<8)|data; HAL_GPIO_WritePin(GPIOB,MAX_DIN_Pin,(w&(1U<<i))?GPIO_PIN_SET:GPIO_PIN_RESET); pulse(GPIOB,MAX_CLK_Pin); } HAL_GPIO_WritePin(GPIOB,MAX_CS_Pin,GPIO_PIN_SET); }
static void display_init(void) { max_write(0x0C,1); max_write(0x0F,0); max_write(0x0B,7); max_write(0x0A,8); for(uint8_t i=1;i<=8;i++)max_write(i,0); }
static void display_show(void) {
  static const uint8_t dig[]={0x7e,0x30,0x6d,0x79,0x33,0x5b,0x5f,0x70,0x7f,0x7b};
  if(state==FAULT){ max_write(1,0x4f);max_write(2,0x05);max_write(3,0x05);max_write(8,dig[fault_code%10]);return; }
  if(state==CONFIG){ config_show(); return; }
  /* Latido visible sólo en reposo sin saldo: 700 ms visible / 200 ms apagado. */
  if(state==IDLE && balance_soles==0 && (HAL_GetTick()%900U)>=700U){ for(uint8_t i=1;i<=8;i++)max_write(i,0); return; }
  uint16_t money=(balance_soles>99)?99:balance_soles; uint16_t cl=(uint16_t)(dispensed_liters*100.0f);
  max_write(1,dig[money/10]); max_write(2,dig[money%10]|0x80); max_write(3,dig[0]); max_write(4,dig[0]);
  max_write(5,dig[(cl/1000)%10]); max_write(6,dig[(cl/100)%10]|0x80); max_write(7,dig[(cl/10)%10]); max_write(8,dig[cl%10]);
}
static void outputs_off(void){ HAL_GPIO_WritePin(GPIOA,VALVE_DISP_Pin|PUMP_Pin|VALVE_RINSE_Pin,GPIO_PIN_RESET); HAL_GPIO_WritePin(GPIOB,HOPPER_MOTOR_Pin|AC_AUX_Pin,GPIO_PIN_RESET); }
static void fault(uint8_t code){ outputs_off(); fault_code=code; state=FAULT; set_shift(0,true); display_show(); }
static void finish(void){ outputs_off(); total_revenue+=(uint32_t)balance_soles; save_due_ms=HAL_GetTick()+1000U; balance_soles=0; dispensed_liters=0; state=IDLE; pause_count=0; rinse_done=false; set_shift(0,false); display_show(); }
static void dispense_start(float liters){
  uint32_t now=HAL_GetTick();
  if(HAL_GPIO_ReadPin(GPIOA,WATER_LEVEL_Pin)!=GPIO_PIN_SET){fault(1);return;}
  target_liters=liters; flow_pulses=0; dispensed_liters=0; last_flow_ms=now;
  dispense_start_ms=now; pause_elapsed_ms=0; last_pause_action_ms=now;
  HAL_GPIO_WritePin(GPIOA,PUMP_Pin|VALVE_DISP_Pin,GPIO_PIN_SET); state=DISPENSING;
}
static uint32_t checksum(const nv_t *n){ const uint32_t *p=(const uint32_t*)n;uint32_t x=0;for(uint32_t i=0;i<(sizeof(nv_t)/4U)-1U;i++)x^=p[i];return x; }
static void nv_load(void){
  const nv_t *n=(const nv_t*)NV_ADDR;
  if(n->magic==NV_MAGIC && n->check==checksum(n)){
    price_2l=n->p2; price_7l=n->p7; price_10l=n->p10; price_20l=n->p20;
    pulses_per_liter=(n->pulses>0U)?n->pulses:430U;
    rinse_seconds=(n->rinse_s>=2U && n->rinse_s<=6U)?n->rinse_s:5U;
    dispense_mode=(n->mode<=1U)?n->mode:0U;
    time_per_liter_ms=(n->time_ms>=10U && n->time_ms<=59990U)?n->time_ms:10000U;
    total_revenue=n->revenue; total_coins=n->coins;
  }
}
static void nv_save(void){
  nv_t n={NV_MAGIC,1,price_2l,price_7l,price_10l,price_20l,pulses_per_liter,rinse_seconds,dispense_mode,0,time_per_liter_ms,total_revenue,total_coins,0};
  n.check=checksum(&n); HAL_FLASH_Unlock();
  FLASH_EraseInitTypeDef e={FLASH_TYPEERASE_PAGES,NV_ADDR,1}; uint32_t err;
  if(HAL_FLASHEx_Erase(&e,&err)==HAL_OK)
    for(uint32_t i=0;i<sizeof(n);i+=2) HAL_FLASH_Program(FLASH_TYPEPROGRAM_HALFWORD,NV_ADDR+i,*(uint16_t*)((uint8_t*)&n+i));
  HAL_FLASH_Lock();
}
static void config_show(void) {
  static const uint8_t d[]={0x7e,0x30,0x6d,0x79,0x33,0x5b,0x5f,0x70,0x7f,0x7b};
  /* Etiquetas: P.2L., P.7L., P.10L., P.20L., MODE, PUL.S, TIME, T.ENJ, C.REC, C.MON. */
  uint8_t a=0x67,b=0,c=0,e=0;
  if(config_step==0){a|=0x80;b=d[2];c=0x0e|0x80;}
  else if(config_step==1){a|=0x80;b=d[7];c=0x0e|0x80;}
  else if(config_step==2){a|=0x80;b=d[1];c=d[0];e=0x0e|0x80;}
  else if(config_step==3){a|=0x80;b=d[2];c=d[0];e=0x0e|0x80;}
  else if(config_step==4){a=0x37;b=0x1d;c=0x3d;e=0x4f;}                 /* MODE */
  else if(config_step==5){a=0x67;b=0x3e;c=0x0e|0x80;e=0x5b;}            /* PUL.S */
  else if(config_step==6){a=0x0f;b=0x06;c=0x37;e=0x4f;}                 /* TIME */
  else if(config_step==7){a=0x0f;b=0x4f|0x80;c=0x15;e=0x78;}            /* T.ENJ */
  else if(config_step==8){a=0x4e|0x80;b=0x05;c=0x4f;e=0x4e;}            /* C.REC */
  else {a=0x4e|0x80;b=0x37;c=0x15;e=0x4e;}                              /* C.MON */
  max_write(1,a);max_write(2,b);max_write(3,c);max_write(4,e);
  if(config_step==4){
    /* SENS = por sensor de flujo; TIME = por tiempo programado. */
    if(config_value==0U){max_write(5,0x5b);max_write(6,0x4f);max_write(7,0x15);max_write(8,0x5b);}
    else {max_write(5,0x0f);max_write(6,0x06);max_write(7,0x37);max_write(8,0x4f);}
    return;
  }
  if(config_step==6){
    /* SS.MS: centésimas (pasos de 10 ms), por ejemplo 10.25. */
    uint32_t s=config_value/1000U,cs=(config_value%1000U)/10U;
    max_write(5,d[(s/10)%10]); max_write(6,d[s%10]|0x80); max_write(7,d[(cs/10)%10]); max_write(8,d[cs%10]); return;
  }
  uint32_t div=1000U;for(uint8_t pos=5;pos<=8;pos++,div/=10U){uint8_t q=(config_value/div)%10U;max_write(pos,(config_value<div&&pos<8)?0:d[q]);}
}
static void config_enter(void){
  config_step=0; config_value=price_2l; state=CONFIG;
  /* En esta placa los dos pulsadores están cruzados respecto de la serigrafía. */
  last_add=HAL_GPIO_ReadPin(GPIOB,BTN_OK_Pin); last_minus=HAL_GPIO_ReadPin(GPIOB,BTN_MINUS_Pin); last_ok=HAL_GPIO_ReadPin(GPIOB,BTN_ADD_Pin);
  add_hold_ms=minus_hold_ms=add_repeat_ms=minus_repeat_ms=0;
  display_show();
}
static void config_delta(int32_t delta){
  uint32_t min=1U,max=9999U,step=1U;
  if(config_step==4U){min=0U;max=1U;}
  else if(config_step==5U){min=1U;max=9999U;}
  else if(config_step==6U){min=10U;max=59990U;step=10U;}
  else if(config_step==7U){min=2U;max=6U;}
  else if(config_step>=8U)return;
  uint32_t amount=(delta<0)?(uint32_t)(-delta):(uint32_t)delta;
  amount*=step;
  if(delta<0) config_value=(config_value>min+amount-1U)?config_value-amount:min;
  else config_value=(config_value+amount<max)?config_value+amount:max;
  display_show();
}
static void config_process(void) {
  GPIO_PinState add=HAL_GPIO_ReadPin(GPIOB,BTN_OK_Pin), minus=HAL_GPIO_ReadPin(GPIOB,BTN_MINUS_Pin), ok=HAL_GPIO_ReadPin(GPIOB,BTN_ADD_Pin);
  uint32_t now=HAL_GetTick();
  if(add==GPIO_PIN_SET && last_add==GPIO_PIN_RESET){
    if(config_step==8U){total_revenue=0;config_value=0;nv_save();} else config_delta(1);
    add_hold_ms=add_repeat_ms=now;
  }
  if(minus==GPIO_PIN_SET && last_minus==GPIO_PIN_RESET){
    if(config_step==8U){total_revenue=0;config_value=0;nv_save();} else config_delta(-1);
    minus_hold_ms=minus_repeat_ms=now;
  }
  /* Repetición sostenida: inicia a 600 ms y acelera en TIME después de 2/4 s. */
  if(add==GPIO_PIN_SET && config_step!=8U && now-add_hold_ms>=600U && now-add_repeat_ms>=120U){
    int32_t delta=(config_step==6U && now-add_hold_ms>=4000U)?50:((config_step==6U && now-add_hold_ms>=2000U)?10:1);
    config_delta(delta); add_repeat_ms=now;
  }
  if(minus==GPIO_PIN_SET && config_step!=8U && now-minus_hold_ms>=600U && now-minus_repeat_ms>=120U){
    int32_t delta=(config_step==6U && now-minus_hold_ms>=4000U)?-50:((config_step==6U && now-minus_hold_ms>=2000U)?-10:-1);
    config_delta(delta); minus_repeat_ms=now;
  }
  if(ok==GPIO_PIN_SET && last_ok==GPIO_PIN_RESET){
    if(config_step==0)price_2l=config_value; else if(config_step==1)price_7l=config_value;
    else if(config_step==2)price_10l=config_value; else if(config_step==3)price_20l=config_value;
    else if(config_step==4)dispense_mode=(uint8_t)config_value; else if(config_step==5)pulses_per_liter=(uint16_t)config_value;
    else if(config_step==6)time_per_liter_ms=config_value; else if(config_step==7)rinse_seconds=(uint16_t)config_value;
    else if(config_step==8)total_revenue=0;
    config_step++;
    if(config_step>9U){nv_save();state=IDLE;display_show();}
    else {
      config_value=(config_step==1U)?price_7l:(config_step==2U)?price_10l:(config_step==3U)?price_20l:
                   (config_step==4U)?dispense_mode:(config_step==5U)?pulses_per_liter:(config_step==6U)?time_per_liter_ms:
                   (config_step==7U)?rinse_seconds:(config_step==8U)?total_revenue:total_coins;
      display_show();
    }
  }
  last_add=add;last_minus=minus;last_ok=ok;
}
void HAL_GPIO_EXTI_Callback(uint16_t pin){ uint32_t now=HAL_GetTick(); if(pin==COIN_Pin){coin_pulses++;last_coin_ms=now;} else if(pin==FLOW_Pin && state==DISPENSING){flow_pulses++;} else if(pin==HOPPER_SENSE_Pin && state==CHANGE){uint32_t us=HAL_GetTick()*1000U;if(us-last_hopper_us>15000U){last_hopper_us=us;hopper_pulses++;}} }

