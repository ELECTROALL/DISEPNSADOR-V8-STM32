/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */
  outputs_off();
  shift_write(0);                 /* monedas liberadas, LEDs apagados al inicio */
  display_init();
  nv_load();
  HAL_NVIC_EnableIRQ(EXTI0_IRQn);
  HAL_NVIC_EnableIRQ(EXTI1_IRQn);
  HAL_NVIC_EnableIRQ(EXTI2_IRQn);
  display_show();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    uint32_t now=HAL_GetTick();
    if(state==IDLE && coin_pulses && now-last_coin_ms>30U){
      uint32_t p=coin_pulses; coin_pulses=0;
      if(balance_soles==0)rinse_done=false;
      balance_soles+=p; total_coins+=p; save_due_ms=now+10000U;
      if(balance_soles>20)balance_soles=20; display_show();
    }
    if(state==CONFIG){ config_process(); continue; }
    GPIO_PinState ok_now=HAL_GPIO_ReadPin(GPIOB,BTN_ADD_Pin);
    if(state==IDLE && balance_soles==0 && ok_now==GPIO_PIN_SET && last_ok==GPIO_PIN_RESET){ config_enter(); last_ok=ok_now; HAL_Delay(220); continue; }
    last_ok=ok_now;
    if((state==RINSING || state==DISPENSING) && HAL_GPIO_ReadPin(GPIOA,WATER_LEVEL_Pin)!=GPIO_PIN_SET) fault(1);
    if(state==RINSING && now-state_start_ms>=((uint32_t)rinse_seconds*1000U)){
      outputs_off(); rinse_done=true; state=IDLE; display_show();
    }
    if(state==CHANGE){ uint32_t p=hopper_pulses; hopper_pulses=0; if(p){change_sent+=p;state_start_ms=now;if(change_sent>=change_due){HAL_GPIO_WritePin(GPIOB,HOPPER_MOTOR_Pin,GPIO_PIN_RESET);balance_soles-=change_due;dispense_start(target_liters);}} else if(now-state_start_ms>2000U)fault(2); }
    if(state==DISPENSING){
      uint32_t active_ms=now-dispense_start_ms-pause_elapsed_ms;
      dispensed_liters=dispense_mode?((float)active_ms/(float)time_per_liter_ms):((float)flow_pulses/pulses_per_liter);
      if(flow_pulses)last_flow_ms=now;
      if(!dispense_mode&&now-last_flow_ms>30000U)fault(3);
      if(dispensed_liters>=target_liters)finish();
    }
    if(state==PAUSED && now-pause_start_ms>30000U)finish();
    if(state==IDLE && balance_soles>0){ float l=0;uint16_t price=0; if(HAL_GPIO_ReadPin(GPIOA,SEL_2L_Pin)) {l=2;price=price_2l;} else if(HAL_GPIO_ReadPin(GPIOA,SEL_7L_Pin)){l=7;price=price_7l;} else if(HAL_GPIO_ReadPin(GPIOA,SEL_10L_Pin)){l=10;price=price_10l;} else if(HAL_GPIO_ReadPin(GPIOA,SEL_20L_Pin)){l=20;price=price_20l;} if(price && balance_soles>=price){change_due=balance_soles-price;target_liters=l;if(change_due){change_sent=0;hopper_pulses=0;state=CHANGE;state_start_ms=now;HAL_GPIO_WritePin(GPIOB,HOPPER_MOTOR_Pin,GPIO_PIN_SET);}else dispense_start(l);HAL_Delay(300);} }
    GPIO_PinState pause_now=HAL_GPIO_ReadPin(GPIOB,PAUSE_Pin);
    if(pause_now==GPIO_PIN_SET && last_pause==GPIO_PIN_RESET){
      if(state==IDLE && balance_soles>0 && !rinse_done){
        HAL_GPIO_WritePin(GPIOA,PUMP_Pin|VALVE_RINSE_Pin,GPIO_PIN_SET);
        state=RINSING; state_start_ms=now;
      } else if(state==DISPENSING && pause_count<3U && now-last_pause_action_ms>=3000U){
        HAL_GPIO_WritePin(GPIOA,PUMP_Pin|VALVE_DISP_Pin,GPIO_PIN_RESET);
        state=PAUSED; pause_start_ms=now; pause_count++; last_pause_action_ms=now;
      } else if(state==PAUSED && now-last_pause_action_ms>=3000U){
        pause_elapsed_ms+=now-pause_start_ms;
        HAL_GPIO_WritePin(GPIOA,PUMP_Pin|VALVE_DISP_Pin,GPIO_PIN_SET);
        state=DISPENSING; last_flow_ms=now; last_pause_action_ms=now;
      }
    }
    last_pause=pause_now;
    if(state==FAULT && HAL_GPIO_ReadPin(GPIOB,BTN_OK_Pin)==GPIO_PIN_SET){finish();HAL_Delay(300);}
    set_shift(0,state!=IDLE); set_shift(1,HAL_GPIO_ReadPin(GPIOA,WATER_LEVEL_Pin)!=GPIO_PIN_SET); set_shift(3,HAL_GPIO_ReadPin(GPIOA,WATER_LEVEL_Pin)==GPIO_PIN_SET); set_shift(4,state==DISPENSING);
    if((now%100U)<5U)display_show();
    if(save_due_ms && now>=save_due_ms){nv_save();save_due_ms=0;}
  }
  /* USER CODE END 3 */
}

